type epdg_wod, domain;
type epdg_wod_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(epdg_wod)

# Basic networking and system control
allow epdg_wod self:capability { net_admin dac_override };
allow epdg_wod self:udp_socket create_socket_perms_no_ioctl;

# Allow it to set system properties for the tunnel status
set_prop(epdg_wod, vendor_mtk_radio_prop)

# Allow interaction with the network stack
allow epdg_wod self:netlink_route_socket nlmsg_write;

# Allow interaction with charon
allow epdg_wod charon:process signal;

# Allow epdg_wod to talk to the property service
set_prop(epdg_wod, vendor_mtk_ctl_epdg_prop)

# =========================================================
# 1. Domain and Execution Types
# =========================================================
type vendor_charon, domain;
type vendor_charon_exec, exec_type, vendor_file_type, file_type;


# =========================================================
# 2. Attribute Assignments (Fixed for Duplicate Declaration)
# =========================================================

# We use typeattribute because these types are already declared in MTK common.
# This ensures they are treated as data partition files to allow writing.
typeattribute wod_apn_conf_file file_type;
typeattribute wod_apn_conf_file data_file_type;

typeattribute wod_ipsec_conf_file file_type;
typeattribute wod_ipsec_conf_file data_file_type;

# =========================================================
# 3. Domain Transitions
# =========================================================
init_daemon_domain(vendor_charon)

# =========================================================
# 4. Global Shared Rules
# =========================================================
get_prop(vendor_epdg_wod, vendor_default_prop)
allow vendor_charon sysfs_boot_mode:file r_file_perms;

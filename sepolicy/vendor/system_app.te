# FM Radio
get_prop(system_app, vendor_mtk_wmt_prop)
get_prop(system_app, vendor_mtk_default_prop)

# Allow system apps (like Dialer/Settings) to find the IMS service
allow system_app mtk_ims_service:service_manager find;

# Allow reading the MediaTek chipname and common properties
get_prop(system_app, vendor_mtk_common_prop)

allow system_app mtk_ims_service:service_manager find;

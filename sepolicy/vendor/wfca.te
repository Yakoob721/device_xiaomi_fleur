# ==============================================================================
# WFCA (Wi-Fi Calling Agent) Unified Custom Permissions
# ==============================================================================

# --- Hardware & Modem Interaction ---
allow wfca ccci_device:chr_file rw_file_perms;
unix_socket_connect(wfca, rild, rild)

# --- Process & Framework Sockets ---
# Socket created by init / used by the IMS framework handover logic
allow wfca wfca_socket:sock_file { create_file_perms rw_file_perms };
allow wfca self:unix_stream_socket create_socket_perms_no_ioctl;

# --- Networking, IPsec Tunneling & Packet Marking ---
allow wfca self:capability { net_admin net_raw };
allow wfca self:udp_socket { create ioctl relabelfrom relabelto };
allowxperm wfca self:udp_socket ioctl { 0x8914 0x8916 0x8922 }; # Explicit MTK VoWiFi ioctls
allow wfca node:udp_socket node_bind;

# --- Network Daemon (Netd) & Firewall Marking (fwmark) ---
allow wfca fwmarkd_socket:sock_file write;
allow wfca netd:unix_stream_socket connectto;

# --- Inter-process Data Handover ---
# Allow wfca to use file descriptors passed from the modem/radio
allow wfca radio:fd use;

# --- Power Management (Fixes "open lock fail" errors) ---
allow wfca sysfs_wake_lock:file rw_file_perms;
allow wfca self:capability2 block_suspend;

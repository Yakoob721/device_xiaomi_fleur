# Allow wfca to use the socket created by init
allow wfca wfca_socket:sock_file rw_file_perms;
# Allow wfca to create the IPsec tunnel
allow wfca self:capability { net_admin net_raw };
allow wfca self:udp_socket create_socket_perms;

# No "type wfca" line here! It's already defined elsewhere.
allow wfca self:capability { net_admin net_raw };
allow wfca self:udp_socket { create ioctl relabelfrom relabelto };

allow wfca self:capability { net_admin net_raw };
allow wfca self:udp_socket { create ioctl relabelfrom relabelto };
allow wfca node:udp_socket node_bind;
allow wfca netd:unix_stream_socket connectto;
# Allow wfca to use file descriptors passed from the modem/radio
allow wfca radio:fd use;
allow wfca self:capability net_admin;

# Allow wfca to create and use the secure IPsec sockets
allow wfca self:udp_socket { create ioctl relabelfrom relabelto };
allow wfca node:udp_socket node_bind;

# Allow communication with the networking daemon
allow wfca netd:unix_stream_socket connectto;

# Permissions to fix the "open lock fail" error in your log
allow wfca sysfs_wake_lock:file rw_file_perms;
allow wfca self:capability2 block_suspend;

# Additional IMS/WFC permissions often needed
allow wfca self:udp_socket create_socket_perms_no_ioctl;
allow wfca node:udp_socket node_bind;

# Allow wfca to create and use its own socket
allow wfca self:unix_stream_socket { create_socket_perms_no_ioctl };
allow wfca fwmarkd_socket:sock_file write;
allow wfca netd:unix_stream_socket connectto;

# Allow wfca to communicate with the RIL
unix_socket_connect(wfca, rild, rild)
# Allow wfca to mark packets (SO_MARK) for the IPsec tunnel
allow wfca self:capability { net_admin net_raw };
allow wfca self:udp_socket { create ioctl relabelfrom relabelto };
allow wfca node:udp_socket node_bind;

# Allow wfca to use the system power management (wakelocks)
allow wfca sysfs_wake_lock:file rw_file_perms;
allow wfca self:capability2 block_suspend;

# Allow wfca to interact with netd for network routing
allow wfca netd:unix_stream_socket connectto;
allow wfca fwmarkd_socket:sock_file write;
